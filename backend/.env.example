# ══════════════════════════════════════════════════════════
#  Pomodoro Lo-Fi — Variables de Entorno
#  COPIA este archivo como .env y completa los valores
#  ¡NUNCA subas el .env a Git!
# ══════════════════════════════════════════════════════════

# ── Spotify ────────────────────────────────────────────────
# Obtén estas credenciales en: https://developer.spotify.com/dashboard
# 1. Crea una app → copia Client ID y Client Secret
# 2. En "Edit Settings" → Redirect URIs → agrega: http://localhost:8000/api/spotify/callback
SPOTIFY_CLIENT_ID=tu_spotify_client_id_aqui
SPOTIFY_CLIENT_SECRET=tu_spotify_client_secret_aqui
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/spotify/callback

# ── Discord ────────────────────────────────────────────────
# Obtén estas credenciales en: https://discord.com/developers/applications
# 1. New Application → OAuth2 → copia Client ID y Client Secret
# 2. En "Redirects" → agrega: http://localhost:8000/api/discord/callback
DISCORD_CLIENT_ID=tu_discord_client_id_aqui
DISCORD_CLIENT_SECRET=tu_discord_client_secret_aqui
DISCORD_REDIRECT_URI=http://localhost:8000/api/discord/callback

# ── OpenWeatherMap ─────────────────────────────────────────
# API gratuita en: https://openweathermap.org/api
# 1. Regístrate → My API Keys → copia tu key
# Plan gratuito: 60 llamadas/minuto, suficiente para este proyecto
OPENWEATHER_API_KEY=tu_openweather_api_key_aqui

# Ciudad de referencia para el clima (formato: Ciudad,CódigoPaís)
WEATHER_CITY=Talca,CL
